# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
dist-performer
dist-console
*.tsbuildinfo
apps/server/tools/

# Runtime data (keep directory structure via .gitkeep / templates)
data/projects/*
!data/projects/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/library/*
!data/library/.gitkeep
!data/library/library.template.json
!data/library/seed-projects/
!data/library/seed-projects/**/*
data/host/*
!data/host/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
!data/downloads/stagesync-*.apk

# Android shells (Performer / Console)
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/**/build/
apps/*/android/**/.cxx/
apps/*/android/**/*.apk
apps/*/android/**/*.aab
apps/*/android/.idea/
# Generated Offline-First web bundle (#692) — filled by syncWebAssets / build-apk.sh
apps/*/android/app/src/main/assets/www/
# Console Faza 4 — nodejs-mobile + optional host server assets (prepare-local-host.mjs)
apps/console/android/app/src/main/jniLibs/
apps/console/android/app/src/main/assets/host/
apps/console/android/app/src/main/assets/host-libnode.properties
apps/console/android/app/libnode/

# Tauri launcher — generated from packages/ui (pnpm sync:launcher-ui)
apps/desktop/launcher/vendor/

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/target
apps/desktop/src-tauri/resources/
apps/desktop/src-tauri/bin/
apps/desktop/src-tauri/lib/
apps/desktop/src-tauri/share/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local dev-hub artifacts (verify logs, scratch)
tmp/

# Misc
.DS_Store
*.pem
apps/server/tools/yt-dlp
data/downloads/*.apk
apps/desktop/src-tauri/bin/*
tmp/
