{
  "name": "@stagesync/web",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build && vite build --mode performer && vite build --mode console && node scripts/aggregate-role-ui.mjs",
    "build:full": "tsc -p tsconfig.build.json --noEmit && vite build",
    "build:performer": "vite build --mode performer",
    "build:console": "vite build --mode console",
    "preview": "vite preview",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "check-types:tests": "tsc -p tsconfig.json --noEmit",
    "check-types:all": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 410",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@stagesync/shared": "workspace:*",
    "@stagesync/ui": "workspace:*",
    "lucide-react": "^1.31.0",
    "opensheetmusicdisplay": "^2.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stagesync/eslint-config": "workspace:*",
    "@stagesync/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "modern-screenshot": "^4.7.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
