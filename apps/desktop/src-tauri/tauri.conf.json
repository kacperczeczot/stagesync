{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StageSync",
  "version": "5.5.0",
  "identifier": "com.stagesync.desktop",
  "build": {
    "frontendDist": "../launcher",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node ./scripts/sync-launcher-ui.mjs && node ./scripts/sync-sidecar-server.mjs && npx --yes serve ./launcher -l 1420 --no-clipboard",
    "beforeBuildCommand": "node ./scripts/sync-launcher-ui.mjs && node ./scripts/prepare-stagesync-setup-bin.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StageSync",
        "theme": "Dark",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html",
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 520,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "bin/stagesync-host",
      "bin/stagesync-setup"
    ],
    "resources": [
      "resources/sidecar/**/*",
      "lib/**/*",
      "share/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "assets/installer/installer.nsi",
        "installerHooks": "assets/installer/installer.nsh",
        "sidebarImage": "assets/installer/sidebar.bmp",
        "headerImage": "assets/installer/header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/kacperczeczot/stagesync/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyQUVGNjNEMkIyODZBRjgKUldUNGFpZ3JQZmF1Y3RVK1ZVYzl3SXFBU210SHhHbDRFSVNoSFUvVUJMQ0d6bytWeGdGZ1o0bE4K"
    }
  }
}
