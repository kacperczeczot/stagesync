{
  "name": "@stagesync/server",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "check-types:tests": "tsc -p tsconfig.json --noEmit",
    "check-types:all": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 4",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "@stagesync/shared": "workspace:*",
    "bonjour-service": "^1.4.4",
    "easymidi": "^3.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@stagesync/eslint-config": "workspace:*",
    "@stagesync/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
